{
  "expo": {
    "name": "Samen",
    "slug": "samen",
    "owner": "stormvoerenterprise",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "samen",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.tomrovers.samen",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tomrovers.samen",
      "adaptiveIcon": {
        "backgroundColor": "#6E2D5C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Samen",
      "themeColor": "#FFF8F5",
      "backgroundColor": "#FFF8F5"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": false
          },
          "sitemap": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8F5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#6E2D5C"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "cbd6a7fa-5a85-48d0-97e9-fb90e6794ad8"
      }
    }
  }
}
